<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXButton?>
<?import com.jfoenix.controls.JFXTextField?>
<?import java.net.URL?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="229.0" prefWidth="427.0" styleClass="mainFxmlClass" xmlns="http://javafx.com/javafx/8.0.111" xmlns:fx="http://javafx.com/fxml/1" fx:controller="hospital.controller.AdminAddSpecialityController">
    <stylesheets>
        <URL value="@/hospital/style/adminaddspeciality.css" />
    </stylesheets>
   <children>
      <JFXTextField fx:id="txtSpecialityName" alignment="CENTER" labelFloat="true" layoutX="105.0" layoutY="34.0" promptText="Speciality Name">
         <font>
            <Font name="System Bold" size="18.0" />
         </font></JFXTextField>
      <JFXTextField fx:id="txtSpecialityDescription" alignment="CENTER" layoutX="105.0" layoutY="110.0" promptText="Speciality Description">
         <font>
            <Font name="System Bold" size="18.0" />
         </font></JFXTextField>
      <JFXButton buttonType="RAISED" layoutX="182.0" layoutY="165.0" onAction="#btnAddSpecializationOnAction" style="-fx-background-color: #5cb85c;" text="ADD" textFill="WHITE">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor></JFXButton>
   </children>
</AnchorPane>
