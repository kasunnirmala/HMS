<AnchorPane id="AnchorPane" prefHeight="892.0" prefWidth="1000.0" styleClass="mainFxmlClass" xmlns="http://javafx.com/javafx/8.0.111" xmlns:fx="http://javafx.com/fxml/1" fx:controller="hospital.controller.DoctorPrescriptionController">
    <stylesheets>
        <URL value="@/hospital/style/doctorprescription.css" />
    </stylesheets>
   <children>
      <VBox layoutX="285.0" layoutY="143.0" prefHeight="400.0" prefWidth="600.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <MenuBar>
              <menus>
                <Menu text="_File">
                  <items>
                    <MenuItem onAction="#newMenuOnAction" text="_New">
