                        <Font name="System Bold" size="18.0" />
                     </font>
                  </JFXTextField>
                  <JFXTextField fx:id="txtPatientID" editable="false" labelFloat="true" promptText="Patient ID">
                     <font>
                        <Font name="System Bold" size="18.0" />
                     </font>
                  </JFXTextField>
                  <JFXTextField fx:id="txtPatientName" editable="false" labelFloat="true" promptText="Patient Name">
                     <font>
                        <Font name="System Bold" size="18.0" />
                     </font>
                  </JFXTextField>
                  <JFXTextField fx:id="txtDateAdmit" editable="false" labelFloat="true" promptText="Date of Admit">
                     <font>
                        <Font name="System Bold" size="18.0" />
                     </font>
                  </JFXTextField>
               </children>
               <padding>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
               </padding>
               <VBox.margin>
                  <Insets left="30.0" right="30.0" />
               </VBox.margin>
            </HBox>
            <HBox prefHeight="100.0" prefWidth="200.0" spacing="50.0" style="-fx-background-color: #eee; -fx-border-color: #aaa; -fx-border-radius: 20; -fx-background-radius: 20;">
               <VBox.margin>
                  <Insets left="30.0" right="30.0" top="10.0" />
               </VBox.margin>
               <padding>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
               </padding>
               <children>
                  <JFXTextField fx:id="txtTreatment" labelFloat="true" onAction="#txtTreatmentOnAction" prefHeight="35.0" prefWidth="404.0" promptText="Treatment">
                     <font>
                        <Font name="System Bold" size="18.0" />
                     </font>
                  </JFXTextField>
                  <JFXTextField fx:id="txtMedicine" labelFloat="true" onAction="#txtMedicineOnAction" prefHeight="35.0" prefWidth="428.0" promptText="Medicine Description">
                     <font>
                        <Font name="System Bold" size="18.0" />
                     </font>
                  </JFXTextField>
                  <JFXTextField fx:id="txtAmount" labelFloat="true" onAction="#txtAmountOnAction" prefHeight="35.0" prefWidth="181.0" promptText="Amount">
                     <font>
                        <Font name="System Bold" size="18.0" />
                     </font>
                  </JFXTextField>
               </children>
            </HBox>
            <TableView fx:id="tblView" prefHeight="417.0" prefWidth="1140.0">
