<AnchorPane id="AnchorPane" prefHeight="800.0" prefWidth="1200.0" styleClass="mainFxmlClass" xmlns="http://javafx.com/javafx/8.0.111" xmlns:fx="http://javafx.com/fxml/1" fx:controller="hospital.controller.MedicineOperatorMainController">
   <stylesheets>
      <URL value="@/hospital/style/medicaloperator.css" />
   </stylesheets>
   <children>
      <VBox layoutX="456.0" layoutY="118.0" prefHeight="800.0" prefWidth="1200.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <HBox alignment="CENTER" prefHeight="97.0" prefWidth="1200.0">
               <children>
                  <Label text="MEDICINE OPERATOR">
                     <font>
                        <Font name="System Bold" size="48.0" />
                     </font>
                  </Label>
               </children>
            </HBox>
            <HBox alignment="CENTER" prefHeight="96.0" prefWidth="1140.0" spacing="50.0" style="-fx-background-color: #eee; -fx-border-color: #aaa; -fx-border-radius: 20; -fx-background-radius: 20;">
               <children>
                  <JFXTextField fx:id="txtRoomNo" labelFloat="true" onAction="#txtRoomNoOnAction" promptText="Room No">
                     <font>
                        <Font name="System Bold" size="18.0" />
                     </font>
                  </JFXTextField>
                  <JFXTextField fx:id="txtRoomType" editable="false" labelFloat="true" promptText="Room Type">
