                  <TableColumn prefWidth="380.0" text="Treatment" />
                  <TableColumn prefWidth="423.0" text="Medicine Description" />
                  <TableColumn prefWidth="153.0" text="Amount" />
                  <TableColumn prefWidth="183.0" text="Date" />
